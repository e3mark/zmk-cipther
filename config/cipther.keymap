#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <0 1 3 2 4 5 6 14 15 16 17 18 19 20 28 29 42 43 44 45 46 47 56 57 58 48 21 22 23 24 25 26 27 7 8 9 10 11 12 13 33 34 35>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <37 7 8 9 10 11 12 13 21 22 23 24 25 26 27 35 36 38 39 40 41 55 54 53 52 51 50 69 68 67 49 0 1 2 3 4 14 20 15 5 6 28 29 34 33 16 17 18 19>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        func {
            bindings = <&none>;
            key-positions = <2 3>;
            layers = <4>;
        };

        sym {
            bindings = <&none>;
            key-positions = <22 23>;
            layers = <3>;
        };
    };

    macros {
        backdots: backdots {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp DOT &kp FSLH>;
            label = "BACKDOTS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Querty {
            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            //                  | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&lt 6 Q       &kp W  &kp E      &kp R              &kp T           &kp Y        &kp U               &kp I        &kp O    &lt 6 P
&hml LCTRL A  &kp S  &kp D      &hml LEFT_SHIFT F  &kp G           &kp H        &hmr RIGHT_SHIFT J  &kp K        &kp L    &hmr RCTRL SEMICOLON
&kp Z         &kp X  &kp C      &kp V              &kp B           &kp N        &kp M               &kp COMMA    &kp DOT  &kp FSLH
                     &lt 3 TAB  &lt 2 BACKSPACE    &lt 3 LEFT_GUI  &lt 3 ENTER  &lt 4 SPACE         &lt 3 ENTER
            >;
        };

        Colemak-dh {
            bindings = <
&lt 6 Q       &kp W  &kp F      &kp P              &kp B           &kp J        &kp L               &kp U        &kp Y    &kp SEMICOLON
&hml LCTRL A  &kp R  &kp S      &hml LEFT_SHIFT T  &kp G           &kp M        &hmr RIGHT_SHIFT N  &kp E        &kp I    &hmr RCTRL O
&kp Z         &kp X  &kp C      &kp D              &kp V           &kp K        &kp H               &kp COMMA    &kp DOT  &kp FSLH
                     &lt 3 TAB  &lt 2 BACKSPACE    &lt 3 LEFT_GUI  &lt 3 ENTER  &kp SPACE           &lt 3 ENTER
            >;
        };

        Num-Nav {
            // -----------------------------------------------------------------------------------------
            // |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |
            // | BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |
            // |     |     |     |     |     |   |     |     |     |     |     |
            //                  | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ESC         &kp HOME        &kp UP_ARROW  &kp END          &kp PAGE_UP    &kp COMMA  &kp N7        &kp N8        &kp N9        &kp ASTERISK
&kp LEFT_SHIFT  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &kp PAGE_DOWN  &kp PLUS   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL
&kp LC(Z)       &kp LC(X)       &kp LC(C)     &kp LC(V)        &kp CAPS       &kp MINUS  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH
                                &trans        &trans           &trans         &trans     &kp NUMBER_0  &kp DOT
            >;
        };

        Symbols {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN       &kp HASH          &kp DOLLAR         &kp PERCENT    &kp CARET          &kp AMPERSAND     &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LESS_THAN    &kp GREATER_THAN  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp COLON      &kp PLUS           &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp QUESTION          &kp EQUAL
&kp TILDE        &kp GRAVE         &kp PIPE          &kp BACKSLASH      &kp SEMICOLON  &kp MINUS          &kp UNDERSCORE    &kp COMMA        &kp DOT               &kp SLASH
                                   &trans            &none              &none          &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &trans
            >;
        };

        Functions {
            // -----------------------------------------------------------------------------------------
            // |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |
            // |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |
            // |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |
            //                  | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &none  &none   &none   &none   &kp K_VOL_UP       &kp F7  &kp F8  &kp F9  &kp F10
&none  &none  &none   &none   &trans  &kp K_VOLUME_DOWN  &kp F4  &kp F5  &kp F6  &kp F11
&none  &none  &trans  &trans  &trans  &kp C_MUTE         &kp F1  &kp F2  &kp F3  &kp F12
              &trans  &trans  &trans  &trans             &trans  &trans
            >;
        };

        System {
            bindings = <
&bootloader   &trans        &trans        &trans        &to 0       &to 1   &trans  &trans  &trans  &bootloader
&trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR  &trans  &trans  &trans  &trans  &trans
                            &trans        &trans        &trans      &trans  &trans  &trans
            >;
        };

        SystemX {
            bindings = <
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &to 0   &to 1   &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
&bootloader     &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &bootloader
                              &trans        &trans        &trans  &trans  &trans  &trans
            >;
        };
    };
};
