#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <0 1 3 2 4 5 6 14 15 16 17 18 19 20 28 29 42 43 44 45 46 47 56 57 58 48 21 22 23 24 25 26 27 7 8 9 10 11 12 13 33 34 35>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <37 7 8 9 10 11 12 13 21 22 23 24 25 26 27 35 36 38 39 40 41 55 54 53 52 51 50 69 68 67 49 0 1 2 3 4 14 20 15 5 6 28 29 34 33 16 17 18 19>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&mt LEFT_ALT TAB>;
            key-positions = <12 13>;
            layers = <0>;
        };

        enter_1 {
            bindings = <&kp ENTER>;
            key-positions = <16 17 18>;
            layers = <0>;
        };

        quote {
            bindings = <&mt RIGHT_ALT SINGLE_QUOTE>;
            key-positions = <16 17>;
            layers = <0>;
        };

        double-quote {
            bindings = <&mt RIGHT_GUI DOUBLE_QUOTES>;
            key-positions = <17 18>;
            layers = <0>;
        };

        enter_2 {
            bindings = <&kp ENTER>;
            key-positions = <11 12 13>;
            layers = <0>;
        };

        brace_1 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <3 2>;
            layers = <0>;
        };

        brace_2 {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <1 2 3>;
            layers = <0>;
        };

        bracket-1 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <22 23>;
            layers = <0>;
        };

        bracket-2 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <21 22 23>;
            layers = <0>;
        };

        paren_1 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <6 7>;
            layers = <0>;
        };

        paren_2 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8 6>;
            layers = <0>;
        };

        compare_1 {
            bindings = <&kp LESS_THAN>;
            key-positions = <26 27>;
            layers = <0>;
        };

        compare_2 {
            bindings = <&kp GREATER_THAN>;
            key-positions = <27 28 26>;
            layers = <0>;
        };
    };

    macros {
        backdots: backdots {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp DOT &kp FSLH>;
            label = "BACKDOTS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Querty {
            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            //                  | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&lt 5 Q            &kp W            &kp E        &kp R              &kp T           &kp Y        &kp U               &kp I               &kp O               &lt 5 P
&hml LEFT_SHIFT A  &kp S            &lt 3 D      &hml LEFT_SHIFT F  &kp G           &kp H        &hmr RIGHT_SHIFT J  &lt 3 K             &kp L               &hmr RIGHT_SHIFT SEMICOLON
&hml LEFT_GUI Z    &hml LEFT_ALT X  &kp C        &kp V              &kp B           &kp N        &kp M               &kp COMMA           &hmr RIGHT_ALT DOT  &hmr RIGHT_GUI SLASH
                                    &lt 3 MINUS  &lt 1 BACKSPACE    &hml LCTRL TAB  &lt 4 ENTER  &lt 1 SPACE         &lt 3 SINGLE_QUOTE
            >;
        };

        Num-Nav {
            // -----------------------------------------------------------------------------------------
            // |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |
            // | BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |
            // |     |     |     |     |     |   |     |     |     |     |     |
            //                  | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ESCAPE      &kp HOME        &kp UP_ARROW  &kp END          &kp PAGE_UP    &kp SLASH     &kp N7        &kp N8        &kp N9        &kp MINUS
&kp LEFT_SHIFT  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &kp PAGE_DOWN  &kp ASTERISK  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS
&kp LCTRL       &none           &none         &to 2            &kp CAPS       &kp DOT       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &hmr RGUI EQUAL
                                &trans        &kp DELETE       &trans         &trans        &kp NUMBER_0  &kp DOT
            >;
        };

        Nav-Num-Lock {
            bindings = <
&kp ESCAPE      &kp HOME        &kp UP_ARROW  &kp END          &kp PAGE_UP    &kp SLASH     &kp N7        &kp N8        &kp N9        &kp MINUS
&kp LEFT_SHIFT  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &kp PAGE_DOWN  &kp ASTERISK  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS
&kp LCTRL       &none           &none         &to 1            &kp CAPS       &kp DOT       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &hmr RIGHT_GUI EQUAL
                                &trans        &kp DELETE       &trans         &trans        &kp NUMBER_0  &kp DOT
            >;
        };

        Symbols {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH        &kp DOLLAR  &kp PERCENT  &kp CARET  &kp AMPERSAND     &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp BACKSLASH    &kp PIPE     &kp UNDERSCORE  &kp MINUS   &none        &kp DOT    &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp LBRC              &kp RIGHT_BRACE
&kp TILDE        &kp GRAVE    &none           &none       &none        &kp SLASH  &kp LESS_THAN     &kp GREATER_THAN   &kp LEFT_BRACKET      &kp RIGHT_BRACKET
                              &trans          &trans      &trans       &trans     &trans            &trans
            >;
        };

        Functions {
            // -----------------------------------------------------------------------------------------
            // |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |
            // |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |
            // |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |
            //                  | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none           &none         &none      &none           &none   &kp K_VOL_UP       &kp F7  &kp F8  &kp F9  &kp F10
&kp LEFT_SHIFT  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &none   &kp K_VOLUME_DOWN  &kp F4  &kp F5  &kp F6  &kp F11
&kp LCTRL       &kp LEFT_GUI  &none      &none           &none   &kp C_MUTE         &kp F1  &kp F2  &kp F3  &kp F12
                              &trans     &kp DELETE      &trans  &trans             &trans  &trans
            >;
        };

        System {
            bindings = <
&trans       &trans          &trans  &trans  &to 0   &to 0   &trans  &trans  &trans        &trans
&trans       &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans
&bootloader  &bt BT_CLR_ALL  &trans  &trans  &to 7   &to 7   &trans  &trans  &bt BT_SEL 0  &bootloader
                             &to 7   &trans  &to 0   &to 0   &trans  &to 7
            >;
        };

        System-bt {
            bindings = <
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &to 0   &none   &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
&bootloader     &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &bootloader
                              &trans        &trans        &trans  &trans  &trans  &trans
            >;
        };

        Zombiod {
            bindings = <
&lt 5 ESC       &kp Q  &kp W         &kp E      &kp R         &kp Y        &kp U               &kp I               &kp O    &lt 5 P
&kp LEFT_SHIFT  &kp A  &kp S         &kp D      &kp F         &kp H        &hmr RIGHT_SHIFT J  &lt 3 K             &kp L    &kp SEMICOLON
&kp RCTRL       &kp Z  &kp X         &kp C      &kp V         &kp N        &kp M               &kp COMMA           &kp DOT  &hml RIGHT_GUI SLASH
                       &kp NUMBER_1  &kp SPACE  &kp NUMBER_2  &lt 4 ENTER  &lt 1 SPACE         &lt 3 SINGLE_QUOTE
            >;
        };
    };
};
